<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.dns-over-https</string>
	<key>PayloadUUID</key>
	<string>1C4C65F6-8F54-5AC2-B69F-9D5F487B022D</string>
	<key>PayloadDisplayName</key>
	<string>DNS over HTTPS (template)</string>
	<key>PayloadDescription</key>
	<string>Template. Encrypted DNS settings. Replace the server URL.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.dns-over-https.1</string>
			<key>PayloadUUID</key>
			<string>DA716939-D2EC-5879-8E92-29E95A715046</string>
			<key>PayloadDisplayName</key>
			<string>DNS settings</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://dns.example.com/dns-query</string>
				<key>ServerAddresses</key>
				<array>
					<string>192.0.2.53</string>
					<string>2001:db8::53</string>
				</array>
			</dict>
			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>
					<string>Connect</string>
				</dict>
			</array>
		</dict>
	</array>
</dict>
</plist>
