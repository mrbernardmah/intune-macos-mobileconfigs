<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.firefox-cis-level1</string>
	<key>PayloadUUID</key>
	<string>CCC84842-9413-586A-AC4B-8CA533143F80</string>
	<key>PayloadDisplayName</key>
	<string>Mozilla Firefox - CIS-aligned Level 1</string>
	<key>PayloadDescription</key>
	<string>Mozilla Firefox managed preferences aligned with CIS Benchmark recommendations (Level 1). CIS publishes these benchmarks for Windows/GPO; settings are translated to macOS here. Not CIS certified. Assign this OR the Level 2 profile, not both.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>org.mozilla.firefox</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.firefox-cis-level1.1</string>
			<key>PayloadUUID</key>
			<string>9CA0F8D5-0E69-5765-99EA-E9AE6CE7DD9B</string>
			<key>PayloadDisplayName</key>
			<string>Mozilla Firefox policies</string>
			<key>EnterprisePoliciesEnabled</key>
			<true/>
			<key>DisableTelemetry</key>
			<true/>
			<key>DisableFirefoxStudies</key>
			<true/>
			<key>DisablePocket</key>
			<true/>
			<key>DisableFeedbackCommands</key>
			<true/>
			<key>DontCheckDefaultBrowser</key>
			<true/>
			<key>DisableAppUpdate</key>
			<false/>
			<key>AppAutoUpdate</key>
			<true/>
			<key>BlockAboutConfig</key>
			<true/>
			<key>DisableSafeMode</key>
			<true/>
			<key>SSLVersionMin</key>
			<string>tls1.2</string>
			<key>HttpsOnlyMode</key>
			<string>enabled</string>
			<key>AutofillCreditCardEnabled</key>
			<false/>
			<key>InstallAddonsPermission</key>
			<dict>
				<key>Default</key>
				<false/>
			</dict>
			<key>ExtensionSettings</key>
			<dict>
				<key>*</key>
				<dict>
					<key>installation_mode</key>
					<string>blocked</string>
					<key>blocked_install_message</key>
					<string>Extensions are restricted by IT policy.</string>
				</dict>
			</dict>
			<key>PopupBlocking</key>
			<dict>
				<key>Default</key>
				<true/>
				<key>Locked</key>
				<true/>
			</dict>
			<key>Cookies</key>
			<dict>
				<key>Behavior</key>
				<string>reject-tracker-and-partition-foreign</string>
				<key>Locked</key>
				<true/>
			</dict>
			<key>EnableTrackingProtection</key>
			<dict>
				<key>Value</key>
				<true/>
				<key>Locked</key>
				<true/>
				<key>Cryptomining</key>
				<true/>
				<key>Fingerprinting</key>
				<true/>
				<key>EmailTracking</key>
				<true/>
			</dict>
			<key>DNSOverHTTPS</key>
			<dict>
				<key>Enabled</key>
				<true/>
				<key>Locked</key>
				<true/>
			</dict>
			<key>FirefoxSuggest</key>
			<dict>
				<key>WebSuggestions</key>
				<false/>
				<key>SponsoredSuggestions</key>
				<false/>
				<key>ImproveSuggest</key>
				<false/>
				<key>Locked</key>
				<true/>
			</dict>
			<key>UserMessaging</key>
			<dict>
				<key>WhatsNew</key>
				<false/>
				<key>ExtensionRecommendations</key>
				<false/>
				<key>FeatureRecommendations</key>
				<false/>
				<key>UrlbarInterventions</key>
				<false/>
				<key>SkipOnboarding</key>
				<true/>
				<key>MoreFromMozilla</key>
				<false/>
				<key>Locked</key>
				<true/>
			</dict>
		</dict>
	</array>
</dict>
</plist>
