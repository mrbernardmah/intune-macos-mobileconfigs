<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.edge-cis-level1</string>
	<key>PayloadUUID</key>
	<string>E1DC3EF3-1E6B-5859-A82E-8D73DCB9E7A1</string>
	<key>PayloadDisplayName</key>
	<string>Microsoft Edge - CIS-aligned Level 1</string>
	<key>PayloadDescription</key>
	<string>Microsoft Edge managed preferences aligned with CIS Benchmark recommendations (Level 1). CIS publishes these benchmarks for Windows/GPO; settings are translated to macOS here. Not CIS certified. Assign this OR the Level 2 profile, not both.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.microsoft.Edge</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.edge-cis-level1.1</string>
			<key>PayloadUUID</key>
			<string>B0E06144-1EAD-5F79-9E73-47F756CCC8F4</string>
			<key>PayloadDisplayName</key>
			<string>Microsoft Edge policies</string>
			<key>ExtensionInstallBlocklist</key>
			<array>
				<string>*</string>
			</array>
			<key>ExtensionInstallAllowlist</key>
			<array/>
			<key>BlockExternalExtensions</key>
			<true/>
			<key>SmartScreenEnabled</key>
			<true/>
			<key>SmartScreenPuaEnabled</key>
			<true/>
			<key>PreventSmartScreenPromptOverride</key>
			<true/>
			<key>PreventSmartScreenPromptOverrideForFiles</key>
			<true/>
			<key>TyposquattingCheckerEnabled</key>
			<true/>
			<key>EnhanceSecurityMode</key>
			<integer>1</integer>
			<key>BlockThirdPartyCookies</key>
			<true/>
			<key>SitePerProcess</key>
			<true/>
			<key>SSLVersionMin</key>
			<string>tls1.2</string>
			<key>DnsOverHttpsMode</key>
			<string>automatic</string>
			<key>DefaultPopupsSetting</key>
			<integer>2</integer>
			<key>DefaultGeolocationSetting</key>
			<integer>2</integer>
			<key>DefaultInsecureContentSetting</key>
			<integer>2</integer>
			<key>DefaultFileSystemWriteGuardSetting</key>
			<integer>2</integer>
			<key>DefaultAutomaticDownloadsSetting</key>
			<integer>2</integer>
			<key>BasicAuthOverHttpEnabled</key>
			<false/>
			<key>AllowCrossOriginAuthPrompt</key>
			<false/>
			<key>GuidedSwitchEnabled</key>
			<false/>
			<key>EnableMediaRouter</key>
			<false/>
			<key>DownloadRestrictions</key>
			<integer>1</integer>
			<key>TrackingPrevention</key>
			<integer>2</integer>
			<key>DiagnosticData</key>
			<integer>1</integer>
			<key>HideFirstRunExperience</key>
			<true/>
			<key>RelaunchNotification</key>
			<integer>2</integer>
			<key>RelaunchNotificationPeriod</key>
			<integer>604800000</integer>
		</dict>
	</array>
</dict>
</plist>
