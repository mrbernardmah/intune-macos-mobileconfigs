	<key>PayloadDisplayName</key>
	<string>Microsoft Entra - Enterprise SSO Plug-in</string>
	<key>PayloadDescription</key>
	<string>Redirect SSO app extension using the Company Portal extension (Microsoft Enterprise SSO plug-in). Requires Company Portal installed.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.extensiblesso</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.entra-enterprise-sso-redirect.1</string>
			<key>PayloadUUID</key>
			<string>B3A1EBDD-CDD3-531A-85AE-16EA4FEB5672</string>
			<key>PayloadDisplayName</key>
			<string>Enterprise SSO</string>
			<key>ExtensionIdentifier</key>
			<string>com.microsoft.CompanyPortalMac.ssoextension</string>
			<key>TeamIdentifier</key>
			<string>UBF8T346G9</string>
			<key>Type</key>
			<string>Redirect</string>
			<key>URLs</key>
			<array>
				<string>https://login.microsoftonline.com</string>
