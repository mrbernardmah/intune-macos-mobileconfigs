	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.pppc-microsoft-defender</string>
	<key>PayloadUUID</key>
	<string>07715951-FE38-5BDA-B78D-95EF4D00FB18</string>
	<key>PayloadDisplayName</key>
	<string>PPPC - Microsoft Defender for Endpoint</string>
	<key>PayloadDescription</key>
	<string>PPPC grants for: Defender (wdav), Defender Endpoint Security extension, Defender Endpoint DLP daemon, Defender Endpoint DLP agent. Grants every service MDM is allowed to pre-approve (files/folders, Contacts, Calendar, Reminders, Photos, Accessibility, input events); Screen Recording and Input Monitoring are set so standard users can approve without admin. Camera and Microphone cannot be pre-approved by MDM. Does not approve the system/network extensions; those need their own profiles.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
