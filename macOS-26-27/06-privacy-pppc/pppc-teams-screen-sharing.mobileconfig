<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.pppc-teams-screen-sharing</string>
	<key>PayloadUUID</key>
	<string>2FFBCA94-1EB8-5B52-AFA3-BC8B4464804E</string>
	<key>PayloadDisplayName</key>
	<string>PPPC - Teams and Zoom Screen Recording</string>
	<key>PayloadDescription</key>
	<string>Lets standard users approve Screen Recording for Teams and Zoom without admin rights. Does not use the Accessibility key (deprecated in macOS 27; use the declarative Privacy key instead).</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.TCC.configuration-profile-policy</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.pppc-teams-screen-sharing.1</string>
			<key>PayloadUUID</key>
			<string>53DF8BD8-9E8E-50E6-80D3-3F4BD90E0562</string>
			<key>PayloadDisplayName</key>
			<string>Privacy</string>
			<key>Services</key>
			<dict>
				<key>ScreenCapture</key>
				<array>
					<dict>
						<key>Identifier</key>
						<string>com.microsoft.teams2</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
						<key>CodeRequirement</key>
						<string>identifier "com.microsoft.teams2" and anchor apple generic and certificate leaf[field.1.2.840.113635.100.6.1.9] /* exists */ or anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = UBF8T346G9</string>
						<key>StaticCode</key>
						<false/>
						<key>Authorization</key>
						<string>AllowStandardUserToSetSystemService</string>
						<key>Comment</key>
						<string>Microsoft Teams</string>
					</dict>
					<dict>
						<key>Identifier</key>
						<string>us.zoom.xos</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
						<key>CodeRequirement</key>
						<string>identifier "us.zoom.xos" and anchor apple generic and certificate leaf[field.1.2.840.113635.100.6.1.9] /* exists */ or anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = BJ4HAAB9B3</string>
						<key>StaticCode</key>
						<false/>
						<key>Authorization</key>
						<string>AllowStandardUserToSetSystemService</string>
						<key>Comment</key>
						<string>Zoom</string>
					</dict>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
