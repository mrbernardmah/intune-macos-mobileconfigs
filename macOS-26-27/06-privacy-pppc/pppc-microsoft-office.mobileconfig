	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.pppc-microsoft-office</string>
	<key>PayloadUUID</key>
	<string>7432C6C4-1450-5A25-9C6D-86521A6BF618</string>
	<key>PayloadDisplayName</key>
	<string>PPPC - Microsoft Office (Word, Excel, PowerPoint, Outlook, OneNote)</string>
	<key>PayloadDescription</key>
	<string>PPPC grants for: Microsoft Word, Microsoft Excel, Microsoft PowerPoint, Microsoft Outlook, Microsoft OneNote. Grants every service MDM is allowed to pre-approve (files/folders, Contacts, Calendar, Reminders, Photos, Accessibility, input events); Screen Recording and Input Monitoring are set so standard users can approve without admin. Camera and Microphone cannot be pre-approved by MDM. </string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
