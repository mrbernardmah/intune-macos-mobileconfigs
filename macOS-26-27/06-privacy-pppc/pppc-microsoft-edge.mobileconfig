	<key>PayloadDisplayName</key>
	<string>PPPC - Microsoft Edge</string>
	<key>PayloadDescription</key>
	<string>PPPC grants for: Microsoft Edge. Grants every service MDM is allowed to pre-approve (files/folders, Contacts, Calendar, Reminders, Photos, Accessibility, input events); Screen Recording and Input Monitoring are set so standard users can approve without admin. Camera and Microphone cannot be pre-approved by MDM. </string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
