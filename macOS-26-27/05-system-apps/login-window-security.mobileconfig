<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadIdentifier</key>
	<string>io.github.mrbernardmah.intune.login-window-security</string>
	<key>PayloadUUID</key>
	<string>73FA9272-2A4A-5C53-99E9-5A9C633D53EC</string>
	<key>PayloadDisplayName</key>
	<string>Login Window - Banner and Security</string>
	<key>PayloadDescription</key>
	<string>Legal banner, shows name and password fields, disables auto-login, console login and FDE auto-login.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.loginwindow</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>io.github.mrbernardmah.intune.login-window-security.1</string>
			<key>PayloadUUID</key>
			<string>97273021-D071-5C97-8A3C-B6E3158895B0</string>
			<key>PayloadDisplayName</key>
			<string>Login window</string>
			<key>LoginwindowText</key>
			<string>Authorised use only. Activity may be monitored.</string>
			<key>SHOWFULLNAME</key>
			<true/>
			<key>DisableFDEAutoLogin</key>
			<true/>
			<key>DisableConsoleAccess</key>
			<true/>
			<key>HideAdminUsers</key>
			<true/>
			<key>com.apple.login.mcx.DisableAutoLoginClient</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
