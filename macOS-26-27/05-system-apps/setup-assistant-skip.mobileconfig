	<key>PayloadDisplayName</key>
	<string>Setup Assistant - Skip Panes</string>
	<key>PayloadDescription</key>
	<string>Skips optional Setup Assistant panes for new users. For ADE enrollments also set skip keys in the Intune enrollment profile; some panes (e.g. Age Range) cannot be skipped outside ADE on macOS 26.</string>
	<key>PayloadOrganization</key>
	<string>Intune macOS Profiles (community)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.SetupAssistant.managed</string>
